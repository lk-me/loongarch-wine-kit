+#if defined(__loongarch__)
+/* LoongArch 没有 128 位原子指令，clang 会把 __int128 的原子比较交换改写成对
+ * __atomic_compare_exchange_16 的库调用，而当前交叉工具链不提供 libatomic。
+ * 这里用自旋锁实现；参数必须与 clang AtomicExpandPass 生成的 ABI 一致：
+ *   bool __atomic_compare_exchange_16(i128 *ptr, i128 *expected, i128 desired,
+ *                                     int success_memorder, int failure_memorder)
+ * 注意 desired 按值传递，而不是 libatomic 的指针形式。 */
+static LONG atomic16_lock;
+
+BOOL __atomic_compare_exchange_16( unsigned __int128 *ptr, unsigned __int128 *expected,
+                                   unsigned __int128 desired, int success_memorder,
+                                   int failure_memorder )
+{
+    unsigned __int128 old;
+    BOOL ret;
+
+    spin_lock( &atomic16_lock );
+    old = *ptr;
+    ret = (old == *expected);
+    if (ret) *ptr = desired;
+    else *expected = old;
+    spin_unlock( &atomic16_lock );
+    return ret;
+}
+#endif
+
