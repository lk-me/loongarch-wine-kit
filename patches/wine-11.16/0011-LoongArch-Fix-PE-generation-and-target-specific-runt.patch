+/*******************************************************************
+ *           get_asm_local_label
+ *
+ * Return the name of an internal label in generated asm code.
+ *
+ * LoongArch COFF relocations have no addend field, and lld computes
+ * PC-relative fixups from the symbol address only, so temporary ".L"
+ * labels lose their section offset. Use a regular local label there.
+ */
+const char *get_asm_local_label( const char *name )
+{
+    if (target.cpu == CPU_LOONGARCH64) return strmake( ".%s", name );
+    return strmake( ".L%s", name );
+}
