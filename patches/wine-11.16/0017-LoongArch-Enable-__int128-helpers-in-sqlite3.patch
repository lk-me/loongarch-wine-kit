From 0ab5c8dc67ef042c9a33d2f6b54489c11d191cae Mon Sep 17 00:00:00 2001
From: k <k@l>
Date: Fri, 6 Nov 2026 19:56:21 +0800
Subject: [PATCH 17/20] [LoongArch] Enable __int128 helpers in sqlite3

---
 libs/sqlite3/sqlite3.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libs/sqlite3/sqlite3.c b/libs/sqlite3/sqlite3.c
index fdaf4a9..5e370be 100644
--- a/libs/sqlite3/sqlite3.c
+++ b/libs/sqlite3/sqlite3.c
@@ -36840,7 +36840,7 @@ SQLITE_PRIVATE u8 SQLITE_APICALL sqlite3StrIHash(const char *z){
 
 #if !defined(SQLITE_DISABLE_INTRINSIC)               \
   && (defined(__GNUC__) || defined(__clang__))       \
-  && (defined(__x86_64__) || defined(__aarch64__) || \
+  && (defined(__x86_64__) || defined(__aarch64__) || defined(__loongarch__) || \
       (defined(__riscv) && defined(__riscv_xlen) && (__riscv_xlen>32)))
 #define SQLITE_USE_UINT128
 #endif
