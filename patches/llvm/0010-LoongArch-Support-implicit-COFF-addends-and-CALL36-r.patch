index 9ba0f0235..356bc99d7 100644
--- a/lld/COFF/Chunks.h
+++ b/lld/COFF/Chunks.h
@@ -286,7 +286,8 @@ public:
   void applyRelMIPS(uint8_t *off, uint16_t type, OutputSection *os, uint64_t s,
                     uint64_t p, uint64_t imageBase) const;
   void applyRelLoongArch64(uint8_t *off, uint16_t type, OutputSection *os,
-                           uint64_t s, uint64_t p, uint64_t imageBase) const;
+                           uint64_t s, uint64_t p, uint64_t imageBase,
+                           int64_t pairedLowAddend) const;
 
   void getRuntimePseudoRelocs(std::vector<RuntimePseudoReloc> &res);
 
diff --git a/llvm/include/llvm/BinaryFormat/COFF.h b/llvm/include/llvm/BinaryFormat/COFF.h
index ad30ad684..2f6237860 100644
--- a/llvm/include/llvm/BinaryFormat/COFF.h
+++ b/llvm/include/llvm/BinaryFormat/COFF.h
@@ -439,6 +439,10 @@ enum RelocationTypesLoongArch64 : unsigned {
   IMAGE_REL_LOONGARCH64_TOKEN = 0x000C,
   IMAGE_REL_LOONGARCH64_SECTION = 0x000D,
   IMAGE_REL_LOONGARCH64_ADDR64 = 0x000E,
+  // 36-bit PC-relative call, applied to an adjacent pcaddu18i + jirl pair.
+  // Not part of Microsoft's PE/COFF specification; used by this toolchain to
+  // support the LoongArch medium code model call sequence.
+  IMAGE_REL_LOONGARCH64_CALL36 = 0x000F,
   IMAGE_REL_LOONGARCH64_REL32 = 0x0011,
 };
 
diff --git a/llvm/lib/MC/WinCOFFObjectWriter.cpp b/llvm/lib/MC/WinCOFFObjectWriter.cpp
index d00b598ac..9035581e0 100644
--- a/llvm/lib/MC/WinCOFFObjectWriter.cpp
+++ b/llvm/lib/MC/WinCOFFObjectWriter.cpp
@@ -936,6 +936,15 @@ void WinCOFFWriter::recordRelocation(const MCFragment &F, const MCFixup &Fixup,
 
   bool NeedsSecRelSymbol = false;
   bool UseSectionSymbol = A.isTemporary() && !SymbolMap.lookup(&A);
+
+  // LoongArch 的寻址重定位（%pc_hi20/%pc_lo12 等）以字面量重定位类型表示，
+  // 而 COFF 是 REL 式重定位，没有 RELA 的 addend 字段。对同节符号，用一个
+  // 带偏移的标签符号承载这份 addend（立即数保持 0）；未定义的外部符号无法
+  // 这样表达，改由 LoongArchAsmBackend::applyFixup 把 addend 编码进指令立即数，
+  // 链接器再按隐式 addend 解释。
+  bool NeedsLoongArchOffsetSymbol =
+      Header.Machine == COFF::IMAGE_FILE_MACHINE_LOONGARCH64 &&
+      A.isInSection() && Asm->getSymbolOffset(A) + FixedValue != 0;
   uint64_t SecRelSymbolOffset = 0;
   if (IsArm64SecRel12 && A.isInSection()) {
     uint64_t SecRelFixedValue = FixedValue;
@@ -953,6 +962,15 @@ void WinCOFFWriter::recordRelocation(const MCFragment &F, const MCFixup &Fixup,
     }
     Reloc.Symb = getOrCreateSecRelSymbol(A, SecRelSymbolOffset);
     FixedValue = 0;
+  } else if (NeedsLoongArchOffsetSymbol) {
+    uint64_t Offset = Asm->getSymbolOffset(A) + FixedValue;
+    if (!isUInt<32>(Offset)) {
+      getContext().reportError(Fixup.getLoc(),
+                               "relocation addend out of range");
+      return;
+    }
+    Reloc.Symb = getOrCreateSecRelSymbol(A, Offset);
+    FixedValue = 0;
   } else if (UseSectionSymbol) {
     MCSection *TargetSection = &A.getSection();
     assert(
diff --git a/llvm/lib/Target/LoongArch/LoongArchISelLowering.cpp b/llvm/lib/Target/LoongArch/LoongArchISelLowering.cpp
index 97181fc0c..98ca3aa03 100644
--- a/llvm/lib/Target/LoongArch/LoongArchISelLowering.cpp
+++ b/llvm/lib/Target/LoongArch/LoongArchISelLowering.cpp
@@ -4633,7 +4633,10 @@ SDValue LoongArchTargetLowering::lowerGlobalAddress(SDValue Op,
       CM = *GCM;
   }
 
-  return getAddr(N, DAG, CM, GV->isDSOLocal());
+  /* COFF 目标没有 GOT，外部符号也必须按 PCALA 取址，否则会生成
+   * GOT_PC_HI20/GOT_PC_LO12 之类的重定位而 WinCOFFObjectWriter 无法写出。 */
+  return getAddr(N, DAG, CM, GV->isDSOLocal() ||
+                                  DAG.getTarget().getTargetTriple().isOSBinFormatCOFF());
 }
 
 SDValue LoongArchTargetLowering::getStaticTLSAddr(GlobalAddressSDNode *N,
diff --git a/llvm/lib/Target/LoongArch/MCTargetDesc/LoongArchAsmBackend.cpp b/llvm/lib/Target/LoongArch/MCTargetDesc/LoongArchAsmBackend.cpp
index 2d2d52819..70f2c8a86 100644
--- a/llvm/lib/Target/LoongArch/MCTargetDesc/LoongArchAsmBackend.cpp
+++ b/llvm/lib/Target/LoongArch/MCTargetDesc/LoongArchAsmBackend.cpp
@@ -20,6 +20,7 @@
 #include "llvm/MC/MCExpr.h"
 #include "llvm/MC/MCSection.h"
 #include "llvm/MC/MCValue.h"
+#include "llvm/Support/Endian.h"
 #include "llvm/Support/EndianStream.h"
 #include "llvm/Support/LEB128.h"
 #include "llvm/Support/MathExtras.h"
@@ -150,8 +151,33 @@ void LoongArchAsmBackend::applyFixup(const MCFragment &F, const MCFixup &Fixup,
     return; // Doesn't change encoding.
 
   auto Kind = Fixup.getKind();
-  if (mc::isRelocation(Kind))
+  if (mc::isRelocation(Kind)) {
+    // COFF 是 REL 式重定位，对象文件里没有 addend 字段；链接器（lld）对
+    // pcalau12i / 页内偏移这两类重定位按“隐式 addend”解释指令立即数。
+    // 因此把符号地址上的常量偏移编码进指令：pcalau12i 存页号部分，
+    // 12 位偏移指令存页内部分。未定义的外部符号无法像同节符号那样用
+    // 带偏移的标签符号表达，只能走这条路径。
+    if (STI.getTargetTriple().isOSBinFormatCOFF()) {
+      uint32_t Orig = support::endian::read32le(Data);
+      switch (Kind) {
+      case ELF::R_LARCH_PCALA_HI20:
+      case ELF::R_LARCH_PCADD_HI20: {
+        uint32_t Imm = uint32_t(Value >> 12) & 0xFFFFF;
+        support::endian::write32le(Data, (Orig & ~(0xFFFFFu << 5)) | (Imm << 5));
+        break;
+      }
+      case ELF::R_LARCH_PCALA_LO12:
+      case ELF::R_LARCH_PCADD_LO12: {
+        uint32_t Imm = uint32_t(Value) & 0xFFF;
+        support::endian::write32le(Data, (Orig & ~(0xFFFu << 10)) | (Imm << 10));
+        break;
+      }
+      default:
+        break;
+      }
+    }
     return;
+  }
   MCFixupKindInfo Info = getFixupKindInfo(Kind);
   MCContext &Ctx = getContext();
 
