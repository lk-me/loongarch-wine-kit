From bf8943e46beac73522c113f95c58af603f3947fa Mon Sep 17 00:00:00 2001
From: ChenghaoLiu <linkmecry@gmail.com>
Date: Thu, 5 Nov 2026 18:37:38 +0800
Subject: [PATCH 10/13] [LoongArch] Support implicit COFF addends and CALL36
 relocations

COFF has no addend field, so keep the addend in the instruction immediate
and teach lld to interpret it for page-relative relocations. Also apply
the pcaddu18i+jirl call pair as one 36-bit CALL36 fixup and use the ".L"
internal symbol prefix so exports starting with "L" are not dropped.
---
 lld/COFF/Chunks.cpp                           | 60 ++++++++++++++++---
 lld/COFF/Chunks.h                             |  3 +-
 llvm/include/llvm/BinaryFormat/COFF.h         |  4 ++
 llvm/lib/MC/WinCOFFObjectWriter.cpp           | 18 ++++++
 .../LoongArch/LoongArchISelLowering.cpp       |  5 +-
 .../MCTargetDesc/LoongArchAsmBackend.cpp      | 28 ++++++++-
 .../MCTargetDesc/LoongArchMCAsmInfo.cpp       |  4 ++
 .../LoongArchWinCOFFObjectWriter.cpp          |  5 +-
 8 files changed, 115 insertions(+), 12 deletions(-)

diff --git a/lld/COFF/Chunks.cpp b/lld/COFF/Chunks.cpp
index 88dfe6ba8..e6686f3bc 100644
--- a/lld/COFF/Chunks.cpp
+++ b/lld/COFF/Chunks.cpp
@@ -411,12 +411,16 @@ void SectionChunk::applyRelMIPS(uint8_t *off, uint16_t type, OutputSection *os,
 // Interpret the existing immediate in a pcalau12i as a page-granularity
 // addend, then update it with the page offset from the current instruction
 // to the target (PAGEBASE_REL21). The 20-bit immediate lives in bits [24:5].
-static void applyLoongArchAddr(uint8_t *off, uint64_t s, uint64_t p, int shift) {
+// LowAddend carries the sub-page part of the addend from the paired
+// PAGEOFFSET instruction, if it could be determined.
+static void applyLoongArchAddr(uint8_t *off, uint64_t s, int64_t lowAddend,
+                               uint64_t p, int shift) {
   uint32_t orig = read32le(off);
   int64_t imm = SignExtend64<20>((orig >> 5) & 0xFFFFF);
   s += imm << shift;
   // Round to the nearest page, as the paired 12-bit immediate is sign-extended.
-  imm = ((s + (1 << (shift - 1))) >> shift) - (p >> shift);
+  imm = ((int64_t(s) + lowAddend + (1 << (shift - 1))) >> shift) -
+        int64_t(p >> shift);
   uint32_t mask = 0xFFFFF << 5;
   write32le(off, (orig & ~mask) | ((imm & 0xFFFFF) << 5));
 }
@@ -440,9 +444,27 @@ static void applyLoongArchBranch26(uint8_t *off, int64_t v) {
   write32le(off, (orig & ~0x3FFFFFF) | encoded);
 }
 
+// Patch an adjacent pcaddu18i + jirl pair as one 36-bit PC-relative call
+// (CALL36). The upper bits live in the pcaddu18i 20-bit immediate (bits
+// [24:5]) and the lower bits in the jirl 16-bit immediate (bits [25:10]).
+static void applyLoongArchCall36(uint8_t *off, int64_t v) {
+  if ((v + 0x20000) != SignExtend64(v + 0x20000, 38))
+    error("relocation out of range");
+  if (v & 3)
+    error("misaligned call offset");
+  // jirl sign-extends its immediate, so round the upper half accordingly.
+  uint32_t hi20 = (uint32_t)((v + (1 << 17)) >> 18) & 0xFFFFF;
+  uint32_t lo16 = (uint32_t)(v >> 2) & 0xFFFF;
+  uint32_t orig = read32le(off);
+  write32le(off, (orig & ~(0xFFFFF << 5)) | (hi20 << 5));
+  orig = read32le(off + 4);
+  write32le(off + 4, (orig & ~(0xFFFF << 10)) | (lo16 << 10));
+}
+
 void SectionChunk::applyRelLoongArch64(uint8_t *off, uint16_t type,
                                        OutputSection *os, uint64_t s,
-                                       uint64_t p, uint64_t imageBase) const {
+                                       uint64_t p, uint64_t imageBase,
+                                       int64_t pairedLowAddend) const {
   switch (type) {
   case IMAGE_REL_LOONGARCH64_ABSOLUTE:
     break;
@@ -459,15 +481,22 @@ void SectionChunk::applyRelLoongArch64(uint8_t *off, uint16_t type,
     add32(off, s - p - 4);
     break;
   case IMAGE_REL_LOONGARCH64_PAGEBASE_REL21:
-    applyLoongArchAddr(off, s, p, 12);
+    applyLoongArchAddr(off, s, pairedLowAddend, p, 12);
     break;
   case IMAGE_REL_LOONGARCH64_PAGEOFFSET_12A:
-  case IMAGE_REL_LOONGARCH64_PAGEOFFSET_12L:
-    applyLoongArchImm(off, s & 0xfff);
+  case IMAGE_REL_LOONGARCH64_PAGEOFFSET_12L: {
+    // COFF 没有 addend 字段，汇编器把符号地址的常量偏移留在指令立即数里，
+    // 这里需要把它一起算进去（同节符号已由带偏移的标签符号携带，其立即数为 0）。
+    uint32_t orig = read32le(off);
+    applyLoongArchImm(off, (s + ((orig >> 10) & 0xfff)) & 0xfff);
     break;
+  }
   case IMAGE_REL_LOONGARCH64_BRANCH26:
     applyLoongArchBranch26(off, s - p);
     break;
+  case IMAGE_REL_LOONGARCH64_CALL36:
+    applyLoongArchCall36(off, s - p);
+    break;
   case IMAGE_REL_LOONGARCH64_SECTION:
     applySecIdx(off, os, file->symtab.ctx.outputSections.size());
     break;
@@ -581,9 +610,24 @@ void SectionChunk::applyRelocation(uint8_t *off,
   case Triple::mipsel:
     applyRelMIPS(off, rel.Type, os, s, p, imageBase);
     break;
-  case Triple::loongarch64:
-    applyRelLoongArch64(off, rel.Type, os, s, p, imageBase);
+  case Triple::loongarch64: {
+    // PAGEBASE_REL21 的页号四舍五入需要知道紧随其后的 PAGEOFFSET 指令所带的
+    // 低 12 位 addend（COFF 无 addend 字段，汇编器把它留在指令立即数里）。
+    int64_t pairedLowAddend = 0;
+    if (rel.Type == IMAGE_REL_LOONGARCH64_PAGEBASE_REL21) {
+      for (const coff_relocation &r : getRelocs()) {
+        if (r.VirtualAddress != rel.VirtualAddress + 4 ||
+            r.SymbolTableIndex != rel.SymbolTableIndex)
+          continue;
+        if (r.Type == IMAGE_REL_LOONGARCH64_PAGEOFFSET_12A ||
+            r.Type == IMAGE_REL_LOONGARCH64_PAGEOFFSET_12L)
+          pairedLowAddend = SignExtend64<12>((read32le(off + 4) >> 10) & 0xfff);
+        break;
+      }
+    }
+    applyRelLoongArch64(off, rel.Type, os, s, p, imageBase, pairedLowAddend);
     break;
+  }
   default:
     llvm_unreachable("unknown machine type");
   }
