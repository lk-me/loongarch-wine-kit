From 991386d7954cc8723dd053fa1dd89a27b90cff20 Mon Sep 17 00:00:00 2001
From: ChenghaoLiu <linkmecry@gmail.com>
Date: Mon, 2 Nov 2026 17:25:32 +0800
Subject: [PATCH 03/13] [LoongArch] Add mingw/PE driver support for loongarch64

Teach the clang MinGW toolchain and the lld MinGW driver to handle
loongarch64, so `clang --target=loongarch64-w64-mingw32` can drive a
PE link instead of failing with "unknown target triple":
- MinGW.cpp: emit the `loongarch64pe` linker emulation for loongarch64
- lld/MinGW/Driver.cpp: map `-m loongarch64pe` to `-machine:loongarch64`
- lld/Common/DriverDispatcher.cpp: recognize `loongarch64pe` as a PE target
  so ld.lld dispatches to the MinGW driver rather than the ELF driver
---
 clang/lib/Driver/ToolChains/MinGW.cpp | 3 +++
 lld/Common/DriverDispatcher.cpp       | 3 ++-
 lld/MinGW/Driver.cpp                  | 2 ++
 3 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/clang/lib/Driver/ToolChains/MinGW.cpp b/clang/lib/Driver/ToolChains/MinGW.cpp
index 2ab9ba4ea..416c164d2 100644
--- a/clang/lib/Driver/ToolChains/MinGW.cpp
+++ b/clang/lib/Driver/ToolChains/MinGW.cpp
@@ -153,6 +153,9 @@ void tools::MinGW::Linker::ConstructJob(Compilation &C, const JobAction &JA,
   case llvm::Triple::mipsel:
     CmdArgs.push_back("mipspe");
     break;
+  case llvm::Triple::loongarch64:
+    CmdArgs.push_back("loongarch64pe");
+    break;
   default:
     D.Diag(diag::err_target_unknown_triple) << TC.getEffectiveTriple().str();
   }
diff --git a/lld/Common/DriverDispatcher.cpp b/lld/Common/DriverDispatcher.cpp
index 0b71c0809..76aaaa89a 100644
--- a/lld/Common/DriverDispatcher.cpp
+++ b/lld/Common/DriverDispatcher.cpp
@@ -45,7 +45,8 @@ static cl::TokenizerCallback getDefaultQuotingStyle() {
 
 static bool isPETargetName(StringRef s) {
   return s == "i386pe" || s == "i386pep" || s == "thumb2pe" || s == "arm64pe" ||
-         s == "arm64ecpe" || s == "arm64xpe" || s == "mipspe";
+         s == "arm64ecpe" || s == "arm64xpe" || s == "mipspe" ||
+         s == "loongarch64pe";
 }
 
 static std::optional<bool> isPETarget(llvm::ArrayRef<const char *> args) {
diff --git a/lld/MinGW/Driver.cpp b/lld/MinGW/Driver.cpp
index 53cce5b5c..2d294b25f 100644
--- a/lld/MinGW/Driver.cpp
+++ b/lld/MinGW/Driver.cpp
@@ -429,6 +429,8 @@ bool link(ArrayRef<const char *> argsArr, llvm::raw_ostream &stdoutOS,
       add("-machine:arm64x");
     else if (s == "mipspe")
       add("-machine:mips");
+    else if (s == "loongarch64pe")
+      add("-machine:loongarch64");
     else
       error("unknown parameter: -m" + s);
   }
