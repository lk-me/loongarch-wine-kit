index 64fe2160f..1b927caec 100644
--- a/llvm/include/llvm/BinaryFormat/COFF.h
+++ b/llvm/include/llvm/BinaryFormat/COFF.h
@@ -101,6 +101,7 @@ enum MachineTypes : unsigned {
   IMAGE_FILE_MACHINE_ARM64 = 0xAA64,
   IMAGE_FILE_MACHINE_ARM64EC = 0xA641,
   IMAGE_FILE_MACHINE_ARM64X = 0xA64E,
+  IMAGE_FILE_MACHINE_LOONGARCH64 = 0x6264,
   IMAGE_FILE_MACHINE_EBC = 0xEBC,
   IMAGE_FILE_MACHINE_I386 = 0x14C,
   IMAGE_FILE_MACHINE_IA64 = 0x200,
@@ -418,6 +419,28 @@ enum RelocationTypesARM64 : unsigned {
   IMAGE_REL_ARM64_REL32 = 0x0011,
 };
 
+// LoongArch64 COFF 重定位类型。注意：LoongArch 目前没有官方的 Windows ABI /
+// PE 规范，以下取值是参照 ARM64（0x0000-0x0011）暂定的占位定义，后续需由
+// LoongArch Windows ABI 标准化确认，仅用于让 MC 层能输出 COFF 对象。
+enum RelocationTypesLoongArch64 : unsigned {
+  IMAGE_REL_LOONGARCH64_ABSOLUTE = 0x0000,
+  IMAGE_REL_LOONGARCH64_ADDR32 = 0x0001,
+  IMAGE_REL_LOONGARCH64_ADDR32NB = 0x0002,
+  IMAGE_REL_LOONGARCH64_BRANCH26 = 0x0003,
+  IMAGE_REL_LOONGARCH64_PAGEBASE_REL21 = 0x0004,
+  IMAGE_REL_LOONGARCH64_REL21 = 0x0005,
+  IMAGE_REL_LOONGARCH64_PAGEOFFSET_12A = 0x0006,
+  IMAGE_REL_LOONGARCH64_PAGEOFFSET_12L = 0x0007,
+  IMAGE_REL_LOONGARCH64_SECREL = 0x0008,
+  IMAGE_REL_LOONGARCH64_SECREL_LOW12A = 0x0009,
+  IMAGE_REL_LOONGARCH64_SECREL_HIGH12A = 0x000A,
+  IMAGE_REL_LOONGARCH64_SECREL_LOW12L = 0x000B,
+  IMAGE_REL_LOONGARCH64_TOKEN = 0x000C,
+  IMAGE_REL_LOONGARCH64_SECTION = 0x000D,
+  IMAGE_REL_LOONGARCH64_ADDR64 = 0x000E,
+  IMAGE_REL_LOONGARCH64_REL32 = 0x0011,
+};
+
 enum RelocationTypesMips : unsigned {
   IMAGE_REL_MIPS_ABSOLUTE = 0x0000,
   IMAGE_REL_MIPS_REFHALF = 0x0001,
