diff --git a/llvm/lib/Target/LoongArch/MCTargetDesc/LoongArchWinCOFFObjectWriter.cpp b/llvm/lib/Target/LoongArch/MCTargetDesc/LoongArchWinCOFFObjectWriter.cpp
new file mode 100644
index 000000000..80acc0b31
--- /dev/null
+++ b/llvm/lib/Target/LoongArch/MCTargetDesc/LoongArchWinCOFFObjectWriter.cpp
@@ -0,0 +1,205 @@
+//===-- LoongArchWinCOFFObjectWriter.cpp - LoongArch Win COFF Writer ------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// LoongArch 的 Windows COFF 对象写出器。参照 AArch64WinCOFFObjectWriter.cpp
+// 实现。由于 LoongArch 目前没有官方 Windows ABI / PE 规范，重定位类型取值
+// 为暂定占位（见 COFF.h 中的 RelocationTypesLoongArch64），仅用于打通
+// MC 层输出 COFF 对象的最小路径。
+//
+//===----------------------------------------------------------------------===//
+
+#include "LoongArchMCTargetDesc.h"
+#include "MCTargetDesc/LoongArchFixupKinds.h"
+#include "llvm/ADT/Twine.h"
+#include "llvm/BinaryFormat/COFF.h"
+#include "llvm/BinaryFormat/ELF.h"
+#include "llvm/MC/MCAsmBackend.h"
+#include "llvm/MC/MCContext.h"
+#include "llvm/MC/MCExpr.h"
+#include "llvm/MC/MCFixup.h"
+#include "llvm/MC/MCObjectWriter.h"
+#include "llvm/MC/MCValue.h"
+#include "llvm/MC/MCWinCOFFObjectWriter.h"
+
+using namespace llvm;
+
+namespace {
+
+class LoongArchWinCOFFObjectWriter : public MCWinCOFFObjectTargetWriter {
+public:
+  LoongArchWinCOFFObjectWriter(const Triple &TheTriple)
+      : MCWinCOFFObjectTargetWriter(COFF::IMAGE_FILE_MACHINE_LOONGARCH64) {}
+
+  ~LoongArchWinCOFFObjectWriter() override = default;
+
+  unsigned getRelocType(MCContext &Ctx, const MCValue &Target,
+                        const MCFixup &Fixup, bool IsCrossSection,
+                        const MCAsmBackend &MAB) const override;
+
+  bool recordRelocation(const MCFixup &) const override;
+};
+
+} // end anonymous namespace
+
+unsigned LoongArchWinCOFFObjectWriter::getRelocType(
+    MCContext &Ctx, const MCValue &Target, const MCFixup &Fixup,
+    bool IsCrossSection, const MCAsmBackend &MAB) const {
+  unsigned FixupKind = Fixup.getKind();
+  bool PCRel = Fixup.isPCRel();
+
+  if (IsCrossSection) {
+    // IMAGE_REL_LOONGARCH64_REL64 不存在，跨节时把 FK_Data_8 当作 FK_PCRel_4
+    // 处理，使 `.dword a-b` 能降到 REL32，规避 COFF 的局限。
+    if (PCRel || (FixupKind != FK_Data_4 && FixupKind != FK_Data_8)) {
+      Ctx.reportError(Fixup.getLoc(), "Cannot represent this expression");
+      return COFF::IMAGE_REL_LOONGARCH64_ADDR32;
+    }
+    FixupKind = FK_Data_4;
+    PCRel = true;
+  }
+
+  unsigned Spec = Target.getSpecifier();
+
+  switch (FixupKind) {
+  default: {
+    MCFixupKindInfo Info = MAB.getFixupKindInfo(Fixup.getKind());
+    const char *Name = Info.Name ? Info.Name : "<unknown>";
+    Ctx.reportError(Fixup.getLoc(),
+                    Twine("relocation type ") + Name + " (kind " +
+                        Twine(FixupKind) + ") unsupported on COFF targets");
+    return COFF::IMAGE_REL_LOONGARCH64_ABSOLUTE;
+  }
+
+  case FK_Data_4:
+    if (PCRel)
+      return COFF::IMAGE_REL_LOONGARCH64_REL32;
+    switch (Spec) {
+    default:
+      return COFF::IMAGE_REL_LOONGARCH64_ADDR32;
+    case MCSymbolRefExpr::VK_COFF_IMGREL32:
+      return COFF::IMAGE_REL_LOONGARCH64_ADDR32NB;
+    }
+
+  case FK_Data_8:
+    return COFF::IMAGE_REL_LOONGARCH64_ADDR64;
+
+  case FK_SecRel_2:
+    return COFF::IMAGE_REL_LOONGARCH64_SECTION;
+
+  case FK_SecRel_4:
+    return COFF::IMAGE_REL_LOONGARCH64_SECREL;
+
+  // 抽象 fixup：分支与绝对寻址。
+  case LoongArch::fixup_loongarch_b16:
+  case LoongArch::fixup_loongarch_b21:
+  case LoongArch::fixup_loongarch_b26:
+    return COFF::IMAGE_REL_LOONGARCH64_BRANCH26;
+
+  case LoongArch::fixup_loongarch_abs_hi20:
+  case LoongArch::fixup_loongarch_abs_lo12:
+    return COFF::IMAGE_REL_LOONGARCH64_ADDR32;
+
+  case LoongArch::fixup_loongarch_abs64_lo20:
+  case LoongArch::fixup_loongarch_abs64_hi12:
+  case LoongArch::fixup_loongarch_dtprel64:
+    return COFF::IMAGE_REL_LOONGARCH64_ADDR64;
+
+  case LoongArch::fixup_loongarch_dtprel32:
+    return COFF::IMAGE_REL_LOONGARCH64_ADDR32;
+
+  // 原始 ELF 重定位类型：LoongArch 后端对 pcalau12i / addi.d 等寻址指令直接
+  // 用 R_LARCH_* 作为 fixup kind（见 LoongArchMCInstLower / MCCodeEmitter）。
+  // 这里按 ARM64 PE 的 PAGEBASE_REL21 / PAGEOFFSET_12L 类比映射。
+  case ELF::R_LARCH_NONE:
+    return COFF::IMAGE_REL_LOONGARCH64_ABSOLUTE;
+
+  case ELF::R_LARCH_32:
+    return COFF::IMAGE_REL_LOONGARCH64_ADDR32;
+  case ELF::R_LARCH_64:
+    return COFF::IMAGE_REL_LOONGARCH64_ADDR64;
+  case ELF::R_LARCH_32_PCREL:
+    return COFF::IMAGE_REL_LOONGARCH64_REL32;
+  case ELF::R_LARCH_64_PCREL:
+    return COFF::IMAGE_REL_LOONGARCH64_REL32;
+
+  case ELF::R_LARCH_PCALA_HI20:
+    return COFF::IMAGE_REL_LOONGARCH64_PAGEBASE_REL21;
+  case ELF::R_LARCH_PCALA_LO12:
+    return COFF::IMAGE_REL_LOONGARCH64_PAGEOFFSET_12L;
+  case ELF::R_LARCH_PCALA64_LO20:
+  case ELF::R_LARCH_PCALA64_HI12:
+    return COFF::IMAGE_REL_LOONGARCH64_ADDR64;
+
+  case ELF::R_LARCH_PCADD_HI20:
+    return COFF::IMAGE_REL_LOONGARCH64_PAGEBASE_REL21;
+  case ELF::R_LARCH_PCADD_LO12:
+    return COFF::IMAGE_REL_LOONGARCH64_PAGEOFFSET_12L;
+
+  case ELF::R_LARCH_CALL30:
+  case ELF::R_LARCH_CALL36:
+    return COFF::IMAGE_REL_LOONGARCH64_BRANCH26;
+
+  // GOT / TLS 类重定位需要真正的 PE 链接器与运行时支持，暂报错占位。
+  case ELF::R_LARCH_GOT_PC_HI20:
+  case ELF::R_LARCH_GOT_PC_LO12:
+  case ELF::R_LARCH_GOT64_PC_LO20:
+  case ELF::R_LARCH_GOT64_PC_HI12:
+  case ELF::R_LARCH_GOT_HI20:
+  case ELF::R_LARCH_GOT_LO12:
+  case ELF::R_LARCH_GOT64_LO20:
+  case ELF::R_LARCH_GOT64_HI12:
+  case ELF::R_LARCH_TLS_LE_HI20:
+  case ELF::R_LARCH_TLS_LE_LO12:
+  case ELF::R_LARCH_TLS_LE64_LO20:
+  case ELF::R_LARCH_TLS_LE64_HI12:
+  case ELF::R_LARCH_TLS_IE_PC_HI20:
+  case ELF::R_LARCH_TLS_IE_PC_LO12:
+  case ELF::R_LARCH_TLS_IE64_PC_LO20:
+  case ELF::R_LARCH_TLS_IE64_PC_HI12:
+  case ELF::R_LARCH_TLS_IE_HI20:
+  case ELF::R_LARCH_TLS_IE_LO12:
+  case ELF::R_LARCH_TLS_IE64_LO20:
+  case ELF::R_LARCH_TLS_IE64_HI12:
+  case ELF::R_LARCH_TLS_LD_PC_HI20:
+  case ELF::R_LARCH_TLS_LD_HI20:
+  case ELF::R_LARCH_TLS_GD_PC_HI20:
+  case ELF::R_LARCH_TLS_GD_HI20:
+  case ELF::R_LARCH_TLS_DESC_PC_HI20:
+  case ELF::R_LARCH_TLS_DESC_PC_LO12:
+  case ELF::R_LARCH_TLS_DESC64_PC_LO20:
+  case ELF::R_LARCH_TLS_DESC64_PC_HI12:
+  case ELF::R_LARCH_TLS_DESC_HI20:
+  case ELF::R_LARCH_TLS_DESC_LO12:
+  case ELF::R_LARCH_TLS_DESC64_LO20:
+  case ELF::R_LARCH_TLS_DESC64_HI12:
+  case ELF::R_LARCH_TLS_DESC_LD:
+  case ELF::R_LARCH_TLS_DESC_CALL:
+  case ELF::R_LARCH_TLS_LE_HI20_R:
+  case ELF::R_LARCH_TLS_LE_ADD_R:
+  case ELF::R_LARCH_TLS_LE_LO12_R:
+  case ELF::R_LARCH_TLS_LD_PCREL20_S2:
+  case ELF::R_LARCH_TLS_GD_PCREL20_S2:
+  case ELF::R_LARCH_TLS_DESC_PCREL20_S2: {
+    MCFixupKindInfo Info = MAB.getFixupKindInfo(Fixup.getKind());
+    const char *Name = Info.Name ? Info.Name : "<unknown>";
+    Ctx.reportError(Fixup.getLoc(), Twine("relocation type ") + Name +
+                                        " not yet supported on COFF targets");
+    return COFF::IMAGE_REL_LOONGARCH64_ABSOLUTE;
+  }
+  }
+}
+
+bool LoongArchWinCOFFObjectWriter::recordRelocation(
+    const MCFixup &Fixup) const {
+  return true;
+}
+
+std::unique_ptr<MCObjectTargetWriter>
+llvm::createLoongArchWinCOFFObjectWriter(const Triple &TheTriple) {
+  return std::make_unique<LoongArchWinCOFFObjectWriter>(TheTriple);
+}
