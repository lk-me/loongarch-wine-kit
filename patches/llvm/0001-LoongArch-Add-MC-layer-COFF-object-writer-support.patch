 .../MCTargetDesc/LoongArchMCAsmInfo.h         |   6 +
 .../MCTargetDesc/LoongArchMCTargetDesc.cpp    |  16 +-
 .../MCTargetDesc/LoongArchMCTargetDesc.h      |   4 +
 .../LoongArchWinCOFFObjectWriter.cpp          | 205 ++++++++++++++++++
 .../MCTargetDesc/LoongArchWinCOFFStreamer.cpp |  36 +++
 .../MCTargetDesc/LoongArchWinCOFFStreamer.h   |  35 +++
