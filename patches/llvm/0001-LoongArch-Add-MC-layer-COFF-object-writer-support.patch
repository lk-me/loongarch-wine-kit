 llvm/lib/CodeGen/AsmPrinter/CodeViewDebug.cpp |   4 +
 .../LoongArch/LoongArchTargetMachine.cpp      |   8 +-
 .../LoongArch/LoongArchTargetObjectFile.h     |   3 +
 .../LoongArch/MCTargetDesc/CMakeLists.txt     |   2 +
