+
+class MCAsmBackend;
+class MCCodeEmitter;
+class MCContext;
+class MCObjectWriter;
+class MCStreamer;
+
+MCStreamer *createLoongArchWinCOFFStreamer(
+    MCContext &Context, std::unique_ptr<MCAsmBackend> &&TAB,
+    std::unique_ptr<MCObjectWriter> &&OW,
+    std::unique_ptr<MCCodeEmitter> &&Emitter);
+
+} // end namespace llvm
