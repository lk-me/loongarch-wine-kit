+/*******************************************************************
+ *		KiUserExceptionDispatcher (NTDLL.@)
+ */
+__ASM_GLOBAL_FUNC( KiUserExceptionDispatcher,
+                   "addi.d $a0, $sp, 0x260\n\t"   /* rec */
+                   "move $a1, $sp\n\t"           /* context */
+                   "bl dispatch_exception\n\t"
