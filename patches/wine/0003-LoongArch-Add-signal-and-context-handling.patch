+                   "ld.d $t0, $sp, 0\n\t"        /* func */
+                   "ld.d $a0, $sp, 8\n\t"        /* arg1 */
+                   "ld.d $a1, $sp, 0x10\n\t"     /* arg2 */
+                   "ld.d $a2, $sp, 0x18\n\t"     /* arg3 */
+                   "addi.d $a3, $sp, 0x30\n\t"   /* context */
+                   "jirl $ra, $t0, 0\n\t"
+                   "addi.d $a0, $sp, 0x30\n\t"   /* context */
+                   "ld.w $a1, $sp, 0x20\n\t"     /* alertable */
