+                    "fst.d $f14, $t0, 0x180\n\t"
+                    "fst.d $f15, $t0, 0x188\n\t"
+                    "fst.d $f16, $t0, 0x190\n\t"
+                    "fst.d $f17, $t0, 0x198\n\t"
+                    "fst.d $f18, $t0, 0x1a0\n\t"
