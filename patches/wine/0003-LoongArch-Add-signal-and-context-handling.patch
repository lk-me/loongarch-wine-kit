+__ASM_GLOBAL_FUNC( __C_ExecuteExceptionFilter,
+                   "addi.d $sp, $sp, -0x60\n\t"
+                   "st.d $fp, $sp, 0\n\t"
+                   "st.d $ra, $sp, 8\n\t"
+                   "st.d $s0, $sp, 0x10\n\t"
+                   "st.d $s1, $sp, 0x18\n\t"
+                   "st.d $s2, $sp, 0x20\n\t"
+                   "st.d $s3, $sp, 0x28\n\t"
+                   "st.d $s4, $sp, 0x30\n\t"
+                   "st.d $s5, $sp, 0x38\n\t"
+                   "st.d $s6, $sp, 0x40\n\t"
+                   "st.d $s7, $sp, 0x48\n\t"
+                   "st.d $s8, $sp, 0x50\n\t"
+                   "ld.d $fp, $a3, 0\n\t"     /* $fp = frame */
+                   "ld.d $s0, $a3, 0x08\n\t"
+                   "ld.d $s1, $a3, 0x10\n\t"
+                   "ld.d $s2, $a3, 0x18\n\t"
+                   "ld.d $s3, $a3, 0x20\n\t"
+                   "ld.d $s4, $a3, 0x28\n\t"
+                   "ld.d $s5, $a3, 0x30\n\t"
+                   "ld.d $s6, $a3, 0x38\n\t"
+                   "ld.d $s7, $a3, 0x40\n\t"
+                   "ld.d $s8, $a3, 0x48\n\t"
+                   "move $a1, $fp\n\t"
+                   "jirl $ra, $a2, 0\n\t"     /* filter */
+                   "ld.d $s0, $sp, 0x10\n\t"
+                   "ld.d $s1, $sp, 0x18\n\t"
+                   "ld.d $s2, $sp, 0x20\n\t"
+                   "ld.d $s3, $sp, 0x28\n\t"
+                   "ld.d $s4, $sp, 0x30\n\t"
+                   "ld.d $s5, $sp, 0x38\n\t"
+                   "ld.d $s6, $sp, 0x40\n\t"
+                   "ld.d $s7, $sp, 0x48\n\t"
+                   "ld.d $s8, $sp, 0x50\n\t"
+                   "ld.d $fp, $sp, 0\n\t"
+                   "ld.d $ra, $sp, 8\n\t"
