+
+/**********************************************************************
+ *		quit_handler
+ *
+ * SIGQUIT 处理。
+ */
+static void quit_handler( int signal, siginfo_t *siginfo, void *sigcontext )
+{
+    ucontext_t *context = sigcontext;
+
+    if (!is_inside_syscall( SP_sig(context) )) user_mode_abort_thread( 0, get_syscall_frame() );
+    abort_thread(0);
+}
+
+
+/**********************************************************************
+ *		usr1_handler
+ *
+ * SIGUSR1 处理，用于通知线程它被挂起。
+ */
+static void usr1_handler( int signal, siginfo_t *siginfo, void *sigcontext )
+{
+    ucontext_t *ucontext = sigcontext;
+    CONTEXT context;
+
+    if (is_inside_syscall( SP_sig(ucontext) ))
+    {
+        context.ContextFlags = CONTEXT_FULL | CONTEXT_EXCEPTION_REQUEST;
+        NtGetContextThread( GetCurrentThread(), &context );
+        wait_suspend( &context );
+        NtSetContextThread( GetCurrentThread(), &context );
+    }
+    else
+    {
+        save_context( &context, ucontext );
+        context.ContextFlags |= CONTEXT_EXCEPTION_REPORTING;
+        wait_suspend( &context );
+        restore_context( &context, ucontext );
+    }
+}
+
+
+/**********************************************************************
+ *		usr2_handler
+ *
+ * SIGUSR2 处理，用于设置线程上下文。
+ */
+static void usr2_handler( int signal, siginfo_t *siginfo, void *sigcontext )
+{
+    struct syscall_frame *frame = get_syscall_frame();
+    ucontext_t *context = sigcontext;
+    struct fpu_context *fpu;
+    ULONG64 fcc = 0;
+    unsigned int i;
+
+    if (!is_inside_syscall( SP_sig(context) )) return;
+
+    PC_sig(context) = frame->pc;
+    for (i = 0; i < 32; i++) REGn_sig( i, context ) = frame->gpr[i];
+
+    if (!(SIGCONTEXT(context)->sc_flags & SC_USED_FP)) return;
+    if (!(fpu = (struct fpu_context *)get_extended_sigcontext( context, FPU_CTX_MAGIC ))) return;
+
+    for (i = 0; i < 32; i++) fpu->regs[i] = frame->fpr[i];
+    for (i = 0; i < 8; i++) fcc |= (ULONG64)(frame->fcc[i] & 1) << (i * 8);
+    fpu->fcc = fcc;
+    fpu->fcsr = frame->fcsr;
+}
