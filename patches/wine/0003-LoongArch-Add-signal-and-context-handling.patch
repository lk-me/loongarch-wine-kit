+/***********************************************************************
+ *		RtlCaptureContext (NTDLL.@)
+ */
+__ASM_GLOBAL_FUNC( RtlCaptureContext,
+                    /* 先保存会被自己用到的 $a0/$t0，再逐个保存其它寄存器 */
+                    "addi.d $sp, $sp, -16\n\t"
+                    "st.d $a0, $sp, 0\n\t"
+                    "st.d $t0, $sp, 8\n\t"
+                    "move $t0, $a0\n\t"                   /* t0 = context */
+                    "st.d $zero, $t0, 0x08\n\t"           /* context->Gpr[0] */
+                    "st.d $ra,   $t0, 0x10\n\t"           /* context->Gpr[1] */
+                    "st.d $tp,   $t0, 0x18\n\t"           /* context->Gpr[2] */
+                    "st.d $a1,   $t0, 0x30\n\t"           /* context->Gpr[5] */
+                    "st.d $a2,   $t0, 0x38\n\t"           /* context->Gpr[6] */
+                    "st.d $a3,   $t0, 0x40\n\t"           /* context->Gpr[7] */
+                    "st.d $a4,   $t0, 0x48\n\t"           /* context->Gpr[8] */
+                    "st.d $a5,   $t0, 0x50\n\t"           /* context->Gpr[9] */
+                    "st.d $a6,   $t0, 0x58\n\t"           /* context->Gpr[10] */
+                    "st.d $a7,   $t0, 0x60\n\t"           /* context->Gpr[11] */
+                    "st.d $t1,   $t0, 0x70\n\t"           /* context->Gpr[13] */
+                    "st.d $t2,   $t0, 0x78\n\t"           /* context->Gpr[14] */
+                    "st.d $t3,   $t0, 0x80\n\t"           /* context->Gpr[15] */
+                    "st.d $t4,   $t0, 0x88\n\t"           /* context->Gpr[16] */
+                    "st.d $t5,   $t0, 0x90\n\t"           /* context->Gpr[17] */
+                    "st.d $t6,   $t0, 0x98\n\t"           /* context->Gpr[18] */
+                    "st.d $t7,   $t0, 0xa0\n\t"           /* context->Gpr[19] */
+                    "st.d $t8,   $t0, 0xa8\n\t"           /* context->Gpr[20] */
+                    "st.d $r21,  $t0, 0xb0\n\t"           /* context->Gpr[21] */
+                    "st.d $fp,   $t0, 0xb8\n\t"           /* context->Gpr[22] */
+                    "st.d $s0,   $t0, 0xc0\n\t"           /* context->Gpr[23] */
+                    "st.d $s1,   $t0, 0xc8\n\t"           /* context->Gpr[24] */
+                    "st.d $s2,   $t0, 0xd0\n\t"           /* context->Gpr[25] */
+                    "st.d $s3,   $t0, 0xd8\n\t"           /* context->Gpr[26] */
+                    "st.d $s4,   $t0, 0xe0\n\t"           /* context->Gpr[27] */
+                    "st.d $s5,   $t0, 0xe8\n\t"           /* context->Gpr[28] */
+                    "st.d $s6,   $t0, 0xf0\n\t"           /* context->Gpr[29] */
+                    "st.d $s7,   $t0, 0xf8\n\t"           /* context->Gpr[30] */
+                    "st.d $s8,   $t0, 0x100\n\t"          /* context->Gpr[31] */
+                    "ld.d $t1, $sp, 0\n\t"                /* 原始 $a0 */
+                    "st.d $t1, $t0, 0x28\n\t"              /* context->Gpr[4] */
+                    "ld.d $t1, $sp, 8\n\t"                /* 原始 $t0 */
