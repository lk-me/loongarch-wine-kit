+__ASM_GLOBAL_FUNC( KiUserCallbackDispatcher,
+                   "ld.d $a0, $sp, 0\n\t"        /* args */
+                   "ld.w $a1, $sp, 0x08\n\t"     /* len */
+                   "ld.w $a2, $sp, 0x0c\n\t"     /* id */
+                   "ld.d $t0, $r21, 0x60\n\t"    /* peb */
+                   "ld.d $t0, $t0, 0x58\n\t"     /* peb->KernelCallbackTable */
+                   "slli.d $t1, $a2, 3\n\t"
+                   "add.d $t0, $t0, $t1\n\t"
+                   "ld.d $t0, $t0, 0\n\t"
+                   "jirl $ra, $t0, 0\n\t"
+                   ".globl KiUserCallbackDispatcherReturn\n"
+                   "KiUserCallbackDispatcherReturn:\n\t"
+                   "move $a2, $a0\n\t"           /* status */
+                   "move $a1, $zero\n\t"         /* ret_len */
+                   "move $a0, $a1\n\t"           /* ret_ptr */
