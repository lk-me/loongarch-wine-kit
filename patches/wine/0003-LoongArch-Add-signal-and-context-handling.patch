+/***********************************************************************
+ *		RtlRaiseException (NTDLL.@)
+ */
+__ASM_GLOBAL_FUNC( RtlRaiseException,
+                   "addi.d $sp, $sp, -0x260\n\t"  /* 0x240 (context) + 0x20 */
+                   "st.d $fp, $sp, 0\n\t"
+                   "st.d $ra, $sp, 8\n\t"
+                   "st.d $a0, $sp, 0x10\n\t"
+                   "addi.d $a0, $sp, 0x20\n\t"
+                   "bl RtlCaptureContext\n\t"
+                   "addi.d $a1, $sp, 0x20\n\t"    /* context pointer */
+                   "addi.d $a2, $sp, 0x260\n\t"   /* orig stack pointer */
+                   "st.d $a2, $a1, 0x20\n\t"      /* context->Gpr[3] */
+                   "ld.d $a0, $sp, 0x10\n\t"      /* original first parameter */
+                   "st.d $a0, $a1, 0x28\n\t"      /* context->Gpr[4] */
+                   "ld.d $t0, $sp, 0\n\t"         /* frame pointer */
+                   "ld.d $t1, $sp, 8\n\t"         /* return address */
+                   "st.d $t0, $a1, 0xb8\n\t"      /* context->Gpr[22] */
+                   "st.d $t1, $a1, 0x10\n\t"      /* context->Gpr[1] */
+                   "st.d $t1, $a1, 0x108\n\t"     /* context->Pc */
+                   "st.d $t1, $a0, 0x10\n\t"      /* rec->ExceptionAddress */
+                   "ld.w $t2, $a1, 0\n\t"         /* context->ContextFlags */
+                   "lu12i.w $t3, 0x20000\n\t"     /* CONTEXT_LOONGARCH64_UNWOUND_TO_CALL */
+                   "or $t2, $t2, $t3\n\t"
+                   "st.w $t2, $a1, 0\n\t"
+                   "ld.d $t0, $r21, 0x60\n\t"     /* peb */
+                   "ld.bu $t2, $t0, 0x02\n\t"     /* peb->BeingDebugged */
+                   "bnez $t2, 1f\n\t"
+                   "bl dispatch_exception\n"
+                   "1:\tld.d $a0, $sp, 0x10\n\t"
+                   "addi.d $a1, $sp, 0x20\n\t"
+                   "li.d $a2, 1\n\t"
+                   "bl NtRaiseException\n\t"
+                   "bl RtlRaiseStatus\n\t"
+                   "break 0x7000" )
+
+
+/***********************************************************************
+ *           _setjmpex (NTDLL.@)
+ */
+__ASM_GLOBAL_FUNC( NTDLL__setjmpex,
+                   "st.d $a1, $a0, 0\n\t"          /* jmp_buf->Frame */
+                   "st.d $zero, $a0, 8\n\t"        /* jmp_buf->Reserved */
+                   "st.d $s0, $a0, 0x10\n\t"
+                   "st.d $s1, $a0, 0x18\n\t"
+                   "st.d $s2, $a0, 0x20\n\t"
+                   "st.d $s3, $a0, 0x28\n\t"
+                   "st.d $s4, $a0, 0x30\n\t"
+                   "st.d $s5, $a0, 0x38\n\t"
+                   "st.d $s6, $a0, 0x40\n\t"
+                   "st.d $s7, $a0, 0x48\n\t"
+                   "st.d $s8, $a0, 0x50\n\t"
+                   "st.d $fp, $a0, 0x58\n\t"       /* jmp_buf->Fp */
+                   "st.d $ra, $a0, 0x60\n\t"       /* jmp_buf->Ra */
+                   "st.d $sp, $a0, 0x68\n\t"       /* jmp_buf->Sp */
+                   "movfcsr2gr $t0, $fcsr0\n\t"
+                   "st.w $t0, $a0, 0x70\n\t"       /* jmp_buf->Fcsr */
+                   "st.w $zero, $a0, 0x74\n\t"
+                   "fst.d $f24, $a0, 0x78\n\t"
+                   "fst.d $f25, $a0, 0x80\n\t"
+                   "fst.d $f26, $a0, 0x88\n\t"
+                   "fst.d $f27, $a0, 0x90\n\t"
+                   "fst.d $f28, $a0, 0x98\n\t"
+                   "fst.d $f29, $a0, 0xa0\n\t"
+                   "fst.d $f30, $a0, 0xa8\n\t"
+                   "fst.d $f31, $a0, 0xb0\n\t"
+                   "move $a0, $zero\n\t"
+                   "jr $ra" )
+
+
+/*******************************************************************
+ *		longjmp (NTDLL.@)
+ */
+void __cdecl NTDLL_longjmp( _JUMP_BUFFER *buf, int retval )
+{
+    EXCEPTION_RECORD rec;
+
+    if (!retval) retval = 1;
+
+    rec.ExceptionCode = STATUS_LONGJUMP;
+    rec.ExceptionFlags = 0;
+    rec.ExceptionRecord = NULL;
+    rec.ExceptionAddress = NULL;
+    rec.NumberParameters = 1;
+    rec.ExceptionInformation[0] = (DWORD_PTR)buf;
+    RtlUnwind( (void *)buf->Frame, (void *)buf->Ra, &rec, IntToPtr(retval) );
+}
+
+
+/***********************************************************************
+ *           RtlUserThreadStart (NTDLL.@)
+ */
+__ASM_GLOBAL_FUNC( RtlUserThreadStart,
+                   "addi.d $sp, $sp, -16\n\t"
+                   "st.d $fp, $sp, 0\n\t"
+                   "st.d $ra, $sp, 8\n\t"
+                   "pcalau12i $t0, %pc_hi20(pBaseThreadInitThunk)\n\t"
+                   "addi.d $t0, $t0, %pc_lo12(pBaseThreadInitThunk)\n\t"
+                   "ld.d $t0, $t0, 0\n\t"
+                   "move $a2, $a1\n\t"
+                   "move $a1, $a0\n\t"
+                   "move $a0, $zero\n\t"
+                   "jirl $ra, $t0, 0\n\t"
+                   "break 0x7000" )
+
+/******************************************************************
+ *		LdrInitializeThunk (NTDLL.@)
+ */
+void WINAPI LdrInitializeThunk( CONTEXT *context, ULONG_PTR unk2, ULONG_PTR unk3, ULONG_PTR unk4 )
+{
+    loader_init( context, (void **)&context->Gpr[4] );
+    TRACE_(relay)( "\1Starting thread proc %p (arg=%p)\n", (void *)context->Gpr[4], (void *)context->Gpr[5] );
+    NtContinue( context, TRUE );
+}
+
+
+/***********************************************************************
+ *           process_breakpoint
+ */
+__ASM_GLOBAL_FUNC( process_breakpoint,
+                   "break 0x7000\n\t"
+                   "jr $ra" )
+
+/***********************************************************************
+ *		DbgUiRemoteBreakin   (NTDLL.@)
+ */
+__ASM_GLOBAL_FUNC( DbgUiRemoteBreakin,
+                   "addi.d $sp, $sp, -16\n\t"
+                   "st.d $fp, $sp, 0\n\t"
+                   "st.d $ra, $sp, 8\n\t"
+                   "ld.d $a0, $r21, 0x60\n\t"       /* NtCurrentTeb()->Peb */
+                   "ld.bu $a0, $a0, 0x02\n\t"        /* peb->BeingDebugged */
+                   "beqz $a0, 1f\n\t"
+                   "bl DbgBreakPoint\n"
+                   "1:\tmove $a0, $zero\n\t"
+                   "bl RtlExitUserThread\n\t"
+                   "DbgUiRemoteBreakin_handler:\n\t"
+                   "move $sp, $a1\n\t"               /* frame */
+                   "b 1b" )
+
+/**********************************************************************
+ *              DbgBreakPoint   (NTDLL.@)
+ */
+__ASM_GLOBAL_FUNC( DbgBreakPoint, "break 0x7000; jr $ra"
+                    "\n\tnop; nop; nop; nop; nop; nop; nop; nop"
+                    "\n\tnop; nop; nop; nop; nop; nop" );
+
+/**********************************************************************
+ *              DbgUserBreakPoint   (NTDLL.@)
+ */
+__ASM_GLOBAL_FUNC( DbgUserBreakPoint, "break 0x7000; jr $ra"
+                    "\n\tnop; nop; nop; nop; nop; nop; nop; nop"
+                    "\n\tnop; nop; nop; nop; nop; nop" );
+
+#endif  /* __loongarch__ */
