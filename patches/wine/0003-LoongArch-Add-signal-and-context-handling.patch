+/***********************************************************************
+ *           call_user_mode_callback
+ *
+ * 从内核栈切换到用户栈（用户栈上已经准备好 callback_stack_layout），
+ * 然后跳转到 KiUserCallbackDispatcher。
+ */
+extern NTSTATUS call_user_mode_callback( ULONG64 user_sp, void **ret_ptr, ULONG *ret_len,
+                                         void *func, TEB *teb );
+
+__ASM_GLOBAL_FUNC( call_user_mode_callback,
+                   "addi.d $sp, $sp, -0xd0\n\t"
+                   "st.d $fp, $sp, 0\n\t"
+                   "st.d $ra, $sp, 8\n\t"
+                   "move $fp, $sp\n\t"
+                   "st.d $s0, $fp, 0x10\n\t"
+                   "st.d $s1, $fp, 0x18\n\t"
+                   "st.d $s2, $fp, 0x20\n\t"
+                   "st.d $s3, $fp, 0x28\n\t"
+                   "st.d $s4, $fp, 0x30\n\t"
+                   "st.d $s5, $fp, 0x38\n\t"
+                   "st.d $s6, $fp, 0x40\n\t"
+                   "st.d $s7, $fp, 0x48\n\t"
+                   "st.d $s8, $fp, 0x50\n\t"
+                   "fst.d $f24, $fp, 0x58\n\t"
+                   "fst.d $f25, $fp, 0x60\n\t"
+                   "fst.d $f26, $fp, 0x68\n\t"
+                   "fst.d $f27, $fp, 0x70\n\t"
+                   "fst.d $f28, $fp, 0x78\n\t"
+                   "fst.d $f29, $fp, 0x80\n\t"
+                   "fst.d $f30, $fp, 0x88\n\t"
+                   "fst.d $f31, $fp, 0x90\n\t"
+                   "st.d $a1, $fp, 0x98\n\t"       /* ret_ptr */
+                   "st.d $a2, $fp, 0xa0\n\t"       /* ret_len */
+                   "move $r21, $a4\n\t"            /* teb */
+                   "movfcsr2gr $t0, $fcsr0\n\t"
+                   "st.w $t0, $fp, 0xb0\n\t"
+                   "ld.d $t0, $r21, 0\n\t"         /* teb->Tib.ExceptionList */
+                   "st.d $t0, $fp, 0xa8\n\t"
+                   "ld.d $t0, $r21, 0x378\n\t"     /* thread_data->syscall_frame */
+                   "addi.d $t1, $fp, -0x250\n\t"
+                   "st.d $t1, $r21, 0x378\n\t"
+                   "addi.d $t2, $fp, 0xd0\n\t"
+                   "st.d $t0, $t1, 0x240\n\t"      /* frame->prev_frame */
+                   "st.d $t2, $t1, 0x248\n\t"      /* frame->syscall_cfa */
+                   "ld.w $t3, $r21, 0x380\n\t"     /* thread_data->syscall_trace */
+                   "bnez $t3, 1f\n\t"
+                   "move $sp, $a0\n\t"
+                   "jirl $zero, $a3, 0\n"
+                   "1:\tmove $s0, $r21\n\t"
+                   "move $s1, $a0\n\t"
+                   "move $s2, $a3\n\t"
+                   "move $sp, $t1\n\t"
+                   "ld.d $a1, $s1, 0\n\t"          /* args */
+                   "ld.w $a2, $s1, 8\n\t"          /* len */
+                   "ld.w $a0, $s1, 0xc\n\t"        /* id */
+                   "st.w $a0, $fp, 0xb8\n\t"
+                   "bl " __ASM_NAME("trace_usercall") "\n\t"
+                   "move $r21, $s0\n\t"
+                   "move $sp, $s1\n\t"
+                   "jirl $zero, $s2, 0" )
+
+
+/***********************************************************************
+ *           user_mode_callback_return
+ *
+ * 用户回调返回：恢复 syscall 帧、TEB ExceptionList 与 FPU 控制字，
+ * 把返回值写回调用者，然后回到系统调用返回路径。
+ */
+extern void DECLSPEC_NORETURN user_mode_callback_return( void *ret_ptr, ULONG ret_len,
+                                                         NTSTATUS status, TEB *teb );
+
+__ASM_GLOBAL_FUNC( user_mode_callback_return,
+                   "ld.d $t0, $a3, 0x378\n\t"       /* thread_data->syscall_frame */
+                   "ld.d $t1, $t0, 0x240\n\t"      /* frame->prev_frame */
+                   "ld.d $fp, $t0, 0x248\n\t"      /* frame->syscall_cfa */
+                   "st.d $t1, $a3, 0x378\n\t"
+                   "addi.d $fp, $fp, -0xd0\n\t"
+                   "ld.d $t1, $fp, 0xa8\n\t"
+                   "st.d $t1, $a3, 0\n\t"           /* teb->Tib.ExceptionList */
+                   "ld.w $t1, $fp, 0xb0\n\t"
+                   "movgr2fcsr $fcsr0, $t1\n\t"
+                   "ld.d $t1, $fp, 0x98\n\t"
+                   "st.d $a0, $t1, 0\n\t"           /* *ret_ptr = 回调返回值 */
+                   "ld.d $t1, $fp, 0xa0\n\t"
+                   "st.w $a1, $t1, 0\n\t"           /* *ret_len */
+                   "ld.w $t1, $a3, 0x380\n\t"       /* thread_data->syscall_trace */
+                   "beqz $t1, 1f\n\t"
+                   "move $s0, $a2\n\t"              /* 保存 status */
+                   "ld.w $a3, $fp, 0xb8\n\t"        /* id */
+                   "bl " __ASM_NAME("trace_userret") "\n\t"
+                   "move $a2, $s0\n"
+                   "1:\tmove $a0, $a2\n\t"          /* status */
+                   "ld.d $s0, $fp, 0x10\n\t"
+                   "ld.d $s1, $fp, 0x18\n\t"
+                   "ld.d $s2, $fp, 0x20\n\t"
+                   "ld.d $s3, $fp, 0x28\n\t"
+                   "ld.d $s4, $fp, 0x30\n\t"
+                   "ld.d $s5, $fp, 0x38\n\t"
+                   "ld.d $s6, $fp, 0x40\n\t"
+                   "ld.d $s7, $fp, 0x48\n\t"
+                   "ld.d $s8, $fp, 0x50\n\t"
+                   "fld.d $f24, $fp, 0x58\n\t"
+                   "fld.d $f25, $fp, 0x60\n\t"
+                   "fld.d $f26, $fp, 0x68\n\t"
+                   "fld.d $f27, $fp, 0x70\n\t"
+                   "fld.d $f28, $fp, 0x78\n\t"
+                   "fld.d $f29, $fp, 0x80\n\t"
+                   "fld.d $f30, $fp, 0x88\n\t"
+                   "fld.d $f31, $fp, 0x90\n\t"
+                   "ld.d $ra, $fp, 8\n\t"
+                   "addi.d $t0, $fp, 0xd0\n\t"
+                   "ld.d $fp, $fp, 0\n\t"
+                   "move $sp, $t0\n\t"
+                   "jr $ra" )
+
+
+/***********************************************************************
+ *           KeUserModeCallback   (NTDLL.@)
+ */
+NTSTATUS WINAPI KeUserModeCallback( ULONG id, const void *args, ULONG len,
+                                    void **ret_ptr, ULONG *ret_len )
+{
+    struct syscall_frame *frame = get_syscall_frame();
+    ULONG64 sp = (frame->gpr[3] - offsetof( struct callback_stack_layout, args_data[len] ) - 16) & ~15;
+    struct callback_stack_layout *stack = (struct callback_stack_layout *)sp;
+    struct ntdll_thread_data *thread_data = ntdll_get_thread_data();
+
+    if ((char *)thread_data->kernel_stack + min_kernel_stack > (char *)&frame)
+        return STATUS_STACK_OVERFLOW;
+
+    stack->args = stack->args_data;
+    stack->len = len;
+    stack->id = id;
+    stack->lr = frame->gpr[1];
+    stack->sp = frame->gpr[3];
+    stack->pc = frame->pc;
+
+    memcpy( stack->args_data, args, len );
+    return call_user_mode_callback( sp, ret_ptr, ret_len, pKiUserCallbackDispatcher, NtCurrentTeb() );
+}
+
+
+/***********************************************************************
+ *           NtCallbackReturn   (NTDLL.@)
+ */
+NTSTATUS WINAPI NtCallbackReturn( void *ret_ptr, ULONG ret_len, NTSTATUS status )
+{
+    TRACE( "ret_ptr %p, ret_len %u, status %#lx\n", ret_ptr, ret_len, status );
+
+    if (!get_syscall_frame()->prev_frame) return STATUS_NO_CALLBACK_ACTIVE;
+    user_mode_callback_return( ret_ptr, ret_len, status, NtCurrentTeb() );
+}
