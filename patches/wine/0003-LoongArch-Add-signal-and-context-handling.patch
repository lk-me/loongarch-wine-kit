+/***********************************************************************
+ *           save_context
+ *
+ * 从 sigcontext 取得寄存器值。
+ */
+static void save_context( CONTEXT *context, const ucontext_t *sigcontext )
+{
+    unsigned int i;
+
+    context->ContextFlags = CONTEXT_FULL;
+    for (i = 0; i < 32; i++) context->Gpr[i] = REGn_sig( i, sigcontext );
+    context->Pc = PC_sig( sigcontext );
+    save_fpu( context, sigcontext );
+}
+
+
+/***********************************************************************
+ *           restore_context
+ *
+ * 根据寄存器值构造 sigcontext。
+ */
+static void restore_context( const CONTEXT *context, ucontext_t *sigcontext )
+{
+    unsigned int i;
+
+    for (i = 0; i < 32; i++) REGn_sig( i, sigcontext ) = context->Gpr[i];
+    PC_sig( sigcontext ) = context->Pc;
+    restore_fpu( context, sigcontext );
+}
