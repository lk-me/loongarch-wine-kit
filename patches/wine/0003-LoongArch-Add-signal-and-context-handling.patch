+
+/***********************************************************************
+ *           init_syscall_frame
+ */
+void init_syscall_frame( LPTHREAD_START_ROUTINE entry, void *arg, BOOL suspend, TEB *teb )
+{
+    struct syscall_frame *frame = ((struct ntdll_thread_data *)&teb->GdiTebBatch)->syscall_frame;
+    CONTEXT *ctx, context = { CONTEXT_ALL };
+
+    context.Gpr[4]  = (ULONG64)entry;
+    context.Gpr[5]  = (ULONG64)arg;
+    context.Gpr[21] = (ULONG64)teb;
+    context.Gpr[3]  = (ULONG64)teb->Tib.StackBase;
+    context.Pc      = (ULONG64)pRtlUserThreadStart;
+
+    if (suspend)
+    {
+        context.ContextFlags |= CONTEXT_EXCEPTION_REPORTING | CONTEXT_EXCEPTION_ACTIVE;
+        wait_suspend( &context );
+    }
+
+    ctx = (CONTEXT *)((context.Gpr[3] & ~15)) - 1;
+    *ctx = context;
+    ctx->ContextFlags = CONTEXT_FULL;
+    signal_set_full_context( ctx );
+
+    frame->gpr[3]  = (ULONG64)ctx;
+    frame->pc      = (ULONG64)pLdrInitializeThunk;
+    frame->gpr[4]  = (ULONG64)ctx;
+    frame->gpr[21] = (ULONG64)teb;
+    syscall_frame_fixup_for_fastpath( frame );
+
+    pthread_sigmask( SIG_UNBLOCK, &server_block_set, NULL );
+}
