+/***********************************************************************
+ *              NtSetContextThread  (NTDLL.@)
+ *              ZwSetContextThread  (NTDLL.@)
+ */
+NTSTATUS WINAPI NtSetContextThread( HANDLE handle, const CONTEXT *context )
+{
+    struct syscall_frame *frame = get_syscall_frame();
+    NTSTATUS ret = STATUS_SUCCESS;
+    BOOL self = (handle == GetCurrentThread());
+    DWORD flags = context->ContextFlags & ~CONTEXT_LOONGARCH64;
+
+    if (!self)
+    {
+        ret = set_thread_context( handle, context, &self, IMAGE_FILE_MACHINE_LOONGARCH64 );
+        if (ret || !self) return ret;
+    }
+
+    if (flags & CONTEXT_INTEGER)
+    {
+        frame->gpr[0] = context->Gpr[0];
+        /* 跳过 gpr[1] $ra、gpr[2] $tp、gpr[3] $sp */
+        memcpy( frame->gpr + 4, context->Gpr + 4, sizeof(context->Gpr[0]) * 17 );
+        /* 跳过 gpr[21] TEB、gpr[22] $fp */
+        memcpy( frame->gpr + 23, context->Gpr + 23, sizeof(context->Gpr[0]) * 9 );
+    }
+    if (flags & CONTEXT_CONTROL)
+    {
+        frame->gpr[1]  = context->Gpr[1];
+        frame->gpr[3]  = context->Gpr[3];
+        frame->gpr[22] = context->Gpr[22];
+        frame->pc      = context->Pc;
+    }
+    if (flags & CONTEXT_FLOATING_POINT)
+    {
+        memcpy( frame->fpr, context->Fpr, sizeof(frame->fpr) );
+        memcpy( frame->fcc, context->Fcc, sizeof(frame->fcc) );
+        frame->fcsr = context->Fcsr;
+    }
+    if (flags & CONTEXT_DEBUG_REGISTERS) FIXME( "debug registers not supported\n" );
+    frame->restore_flags |= flags & ~CONTEXT_INTEGER;
+    return STATUS_SUCCESS;
+}
+
+
+/***********************************************************************
+ *              NtGetContextThread  (NTDLL.@)
+ *              ZwGetContextThread  (NTDLL.@)
+ */
+NTSTATUS WINAPI NtGetContextThread( HANDLE handle, CONTEXT *context )
+{
+    struct syscall_frame *frame = get_syscall_frame();
+    DWORD needed_flags = context->ContextFlags & ~CONTEXT_LOONGARCH64;
+    BOOL self = (handle == GetCurrentThread());
+
+    if (!self)
+    {
+        NTSTATUS ret = get_thread_context( handle, context, &self, IMAGE_FILE_MACHINE_LOONGARCH64 );
+        if (ret || !self) return ret;
+    }
+
+    if (needed_flags & CONTEXT_INTEGER)
+    {
+        memcpy( context->Gpr, frame->gpr, sizeof(context->Gpr) );
+        context->ContextFlags |= CONTEXT_INTEGER;
+    }
+    if (needed_flags & CONTEXT_CONTROL)
+    {
+        context->Pc = frame->pc;
+        context->ContextFlags |= CONTEXT_CONTROL;
+    }
+    if (needed_flags & CONTEXT_FLOATING_POINT)
+    {
+        memcpy( context->Fpr, frame->fpr, sizeof(context->Fpr) );
+        memcpy( context->Fcc, frame->fcc, sizeof(context->Fcc) );
+        context->Fcsr = frame->fcsr;
+        context->ContextFlags |= CONTEXT_FLOATING_POINT;
+    }
+    if (needed_flags & CONTEXT_DEBUG_REGISTERS) FIXME( "debug registers not supported\n" );
+    set_context_exception_reporting_flags( &context->ContextFlags, CONTEXT_SERVICE_ACTIVE );
+    return STATUS_SUCCESS;
+}
