diff --git a/dlls/ntdll/unix/signal_loongarch64.c b/dlls/ntdll/unix/signal_loongarch64.c
new file mode 100644
index 0000000..b2fbaea
--- /dev/null
+++ b/dlls/ntdll/unix/signal_loongarch64.c
@@ -0,0 +1,1492 @@
+/*
+ * LoongArch64 信号处理
+ *
+ * 由 dlls/ntdll/unix/signal_arm64.c 移植而来。
+ *
+ * 寄存器约定（LoongArch64 ABI）：
+ *   $r0=$zero, $r1=$ra, $r2=$tp, $r3=$sp, $r4-$r11=$a0-$a7,
+ *   $r12-$r20=$t0-$t8, $r21=Wine TEB, $r22=$fp, $r23-$r31=$s0-$s8
+ */
+#if 0
+#pragma makedep unix
+#endif
+
+#ifdef __loongarch__
+
+#include "config.h"
+
+#include <assert.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdlib.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <setjmp.h>
+
+#ifdef HAVE_SYS_UCONTEXT_H
+# include <sys/ucontext.h>
+# include <asm/sigcontext.h>
+#endif
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "ddk/wdm.h"
+#include "wine/exception.h"
+#include "ntdll_misc.h"
+#include "unix_private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(seh);
+
+/***********************************************************************
+ * LoongArch64 的信号上下文访问
+ *
+ * glibc 的 mcontext_t 使用 __pc/__gregs/__flags/__extcontext 命名，
+ * 但其布局与内核的 struct sigcontext 完全一致，这里统一按内核结构访问。
+ */
+#define SIGCONTEXT(context)   ((struct sigcontext *)&(context)->uc_mcontext)
+
+/* All Registers access - only for local access */
+#define REGn_sig(n, context)  (SIGCONTEXT(context)->sc_regs[(n)])
+#define SP_sig(context)       REGn_sig(3, context)              /* 栈指针 */
+#define PC_sig(context)       (SIGCONTEXT(context)->sc_pc)      /* 程序计数器 */
+#define FP_sig(context)       REGn_sig(22, context)             /* 帧指针 */
+#define RA_sig(context)       REGn_sig(1, context)              /* 返回地址 */
+
+static void *get_extended_sigcontext( const ucontext_t *sigcontext, unsigned int magic )
+{
+    struct sctx_info *info;
+    unsigned int i;
+
+    /* 只有实际使用过浮点单元时内核才会写出扩展上下文 */
+    if (!(SIGCONTEXT(sigcontext)->sc_flags & SC_USED_FP)) return NULL;
+
+    info = (struct sctx_info *)((char *)SIGCONTEXT(sigcontext) +
+                                offsetof( struct sigcontext, sc_extcontext ));
+
+    /* 最多遍历 32 项，防止 size 损坏时越界 */
+    for (i = 0; i < 32; i++)
+    {
+        if (!info->magic || !info->size) break;
+        /* sctx_info 之后紧跟着实际的上下文数据 */
+        if (info->magic == magic) return info + 1;
+        info = (struct sctx_info *)((char *)info + info->size);
+    }
+    return NULL;
+}
+
+/***********************************************************************
+ *           syscall_frame
+ *
+ * 内核栈上的系统调用帧，布局与 CONTEXT 前缀一致（便于直接当作 CONTEXT 使用）。
+ */
+struct syscall_frame
+{
+    ULONG                 flags;          /* 000 ContextFlags */
+    ULONG                 reserved;       /* 004 */
+    ULONG64               gpr[32];        /* 008 */
+    ULONG64               pc;             /* 108 */
+    ULONG64               fpr[32];        /* 110 */
+    ULONG                 fcc[8];         /* 210 */
+    ULONG                 fcsr;           /* 230 */
+    ULONG                 restore_flags;  /* 234 */
+    ULONG                 syscall_id;     /* 238 */
+    ULONG                 align;          /* 23c */
+    struct syscall_frame *prev_frame;     /* 240 */
+    void                 *syscall_cfa;    /* 248 */
+};
+
+C_ASSERT( offsetof( struct syscall_frame, gpr ) == 0x008 );
+C_ASSERT( offsetof( struct syscall_frame, pc ) == 0x108 );
+C_ASSERT( offsetof( struct syscall_frame, fpr ) == 0x110 );
+C_ASSERT( offsetof( struct syscall_frame, fcc ) == 0x210 );
+C_ASSERT( offsetof( struct syscall_frame, fcsr ) == 0x230 );
+C_ASSERT( offsetof( struct syscall_frame, restore_flags ) == 0x234 );
+C_ASSERT( offsetof( struct syscall_frame, syscall_id ) == 0x238 );
+C_ASSERT( offsetof( struct syscall_frame, prev_frame ) == 0x240 );
+C_ASSERT( offsetof( struct syscall_frame, syscall_cfa ) == 0x248 );
+C_ASSERT( sizeof( struct syscall_frame ) == 0x250 );
+
+/* 异常派发时使用的栈布局 */
+struct exc_stack_layout
+{
+    CONTEXT context;             /* 000 */
+    CONTEXT_EX context_ex;       /* 240 */
+    EXCEPTION_RECORD rec;        /* 260 */
+    ULONG64 align;               /* 2f8 */
+    ULONG64 sp;                  /* 300 */
+    ULONG64 pc;                  /* 308 */
+    ULONG64 redzone[2];          /* 310 */
+};
+
+C_ASSERT( offsetof( struct exc_stack_layout, context_ex ) == 0x240 );
+C_ASSERT( offsetof( struct exc_stack_layout, rec ) == 0x260 );
+C_ASSERT( offsetof( struct exc_stack_layout, sp ) == 0x300 );
+C_ASSERT( offsetof( struct exc_stack_layout, pc ) == 0x308 );
+C_ASSERT( offsetof( struct exc_stack_layout, redzone ) == 0x310 );
+C_ASSERT( sizeof( struct exc_stack_layout ) == 0x320 );
+
+/* APC 派发时使用的栈布局 */
+struct apc_stack_layout
+{
+    ULONG64 func;                /* 000 */
+    ULONG64 args[3];             /* 008 */
+    BOOL alertable;              /* 020 */
+    ULONG64 align;               /* 028 */
+    CONTEXT context;             /* 030 */
+    ULONG64 redzone[2];          /* 270 */
+};
+
+C_ASSERT( offsetof( struct apc_stack_layout, args ) == 0x008 );
+C_ASSERT( offsetof( struct apc_stack_layout, alertable ) == 0x020 );
+C_ASSERT( offsetof( struct apc_stack_layout, context ) == 0x030 );
+C_ASSERT( offsetof( struct apc_stack_layout, redzone ) == 0x270 );
+C_ASSERT( sizeof( struct apc_stack_layout ) == 0x280 );
+
+/* 用户回调时使用的栈布局 */
+struct callback_stack_layout
+{
+    void                  *args;         /* 000 参数数据指针 */
+    ULONG                  len;          /* 008 参数长度 */
+    ULONG                  id;           /* 00c 回调 id */
+    ULONG64                unknown[5];   /* 010 保留 */
+    ULONG64                lr;           /* 038 返回地址 */
+    ULONG64                sp;           /* 040 机器帧 */
+    ULONG64                pc;           /* 048 */
+    BYTE                   args_data[0]; /* 050 参数数据 */
+};
+
+C_ASSERT( offsetof( struct callback_stack_layout, len ) == 0x008 );
+C_ASSERT( offsetof( struct callback_stack_layout, id ) == 0x00c );
+C_ASSERT( offsetof( struct callback_stack_layout, lr ) == 0x038 );
+C_ASSERT( offsetof( struct callback_stack_layout, sp ) == 0x040 );
+C_ASSERT( offsetof( struct callback_stack_layout, pc ) == 0x048 );
+C_ASSERT( offsetof( struct callback_stack_layout, args_data ) == 0x050 );
+C_ASSERT( sizeof( struct callback_stack_layout ) == 0x050 );
+
+
+/***********************************************************************
+ *           context_init_empty_xstate
+ *
+ * 初始化 CONTEXT_EX，使其指向一个空的 xstate 缓冲区。
+ */
+static inline void context_init_empty_xstate( CONTEXT *context, void *xstate_buffer )
+{
+    CONTEXT_EX *xctx;
+
+    xctx = (CONTEXT_EX *)(context + 1);
+    xctx->Legacy.Length = sizeof(CONTEXT);
+    xctx->Legacy.Offset = -(LONG)sizeof(CONTEXT);
+    xctx->XState.Length = 0;
+    xctx->XState.Offset = (BYTE *)xstate_buffer - (BYTE *)xctx;
+    xctx->All.Length = sizeof(CONTEXT) + xctx->XState.Offset + xctx->XState.Length;
+    xctx->All.Offset = -(LONG)sizeof(CONTEXT);
+}
+
+
+/***********************************************************************
+ *           set_process_instrumentation_callback
+ */
+void set_process_instrumentation_callback( void *callback )
+{
+    if (callback) FIXME( "Not supported.\n" );
+}
+
+
+/***********************************************************************
+ *           syscall_frame_fixup_for_fastpath
+ *
+ * 修正系统调用帧，使调度器在 restore_flags 中设置了 CONTEXT_INTEGER 时
+ * 能走快速返回路径。
+ *
+ * 会覆盖帧中 gpr[12] 与 gpr[13] 的值。
+ */
+static void syscall_frame_fixup_for_fastpath( struct syscall_frame *frame )
+{
+    frame->gpr[12] = frame->pc;
+    frame->gpr[13] = frame->gpr[3];
+}
+
+/***********************************************************************
+ *           save_fpu
+ *
+ * 从 sigcontext 保存 FPU 上下文。
+ */
+static void save_fpu( CONTEXT *context, const ucontext_t *sigcontext )
+{
+    struct fpu_context *fpu;
+    unsigned int i;
+
+    if (!(SIGCONTEXT(sigcontext)->sc_flags & SC_USED_FP)) return;
+    if (!(fpu = (struct fpu_context *)get_extended_sigcontext( sigcontext, FPU_CTX_MAGIC ))) return;
+
+    context->ContextFlags |= CONTEXT_FLOATING_POINT;
+    for (i = 0; i < 32; i++) context->Fpr[i] = fpu->regs[i];
+    /* 内核把 8 个 FCC 各占一个字节保存在 fcc 中 */
+    for (i = 0; i < 8; i++) context->Fcc[i] = (fpu->fcc >> (i * 8)) & 1;
+    context->Fcsr = fpu->fcsr;
+}
+
+
+/***********************************************************************
+ *           restore_fpu
+ *
+ * 把 FPU 上下文恢复到 sigcontext。
+ */
+static void restore_fpu( const CONTEXT *context, ucontext_t *sigcontext )
+{
+    struct fpu_context *fpu;
+    ULONG64 fcc = 0;
+    unsigned int i;
+
+    if (!(SIGCONTEXT(sigcontext)->sc_flags & SC_USED_FP)) return;
+    if (!(fpu = (struct fpu_context *)get_extended_sigcontext( sigcontext, FPU_CTX_MAGIC ))) return;
+
+    for (i = 0; i < 32; i++) fpu->regs[i] = context->Fpr[i];
+    for (i = 0; i < 8; i++) fcc |= (ULONG64)(context->Fcc[i] & 1) << (i * 8);
+    fpu->fcc = fcc;
+    fpu->fcsr = context->Fcsr;
+}
