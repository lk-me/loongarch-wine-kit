diff --git a/dlls/winecrt0/setjmp.c b/dlls/winecrt0/setjmp.c
index a79deeb..8586e0c 100644
--- a/dlls/winecrt0/setjmp.c
+++ b/dlls/winecrt0/setjmp.c
@@ -232,6 +232,67 @@ __ASM_GLOBAL_FUNC( __wine_longjmp,
                    "mov x0, x1\n\t"                /* retval */
                    "ret" )
 
+#elif defined(__loongarch__)
+
+/* jmp_buf layout must match _JUMP_BUFFER in include/msvcrt/setjmp.h:
+ * Frame@0, Reserved@8, S0-S8@0x10..0x50, Fp@0x58, Ra@0x60, Sp@0x68,
+ * Fcsr@0x70, Reserved2@0x74, D[8]@0x78..0xb0. */
+
+__ASM_GLOBAL_FUNC( __wine_setjmpex,
+                   "st.d $a1,   $a0, 0\n\t"        /* jmp_buf->Frame */
+                   "st.d $zero, $a0, 8\n\t"        /* jmp_buf->Reserved */
+                   "st.d $s0,   $a0, 0x10\n\t"     /* jmp_buf->S0 */
+                   "st.d $s1,   $a0, 0x18\n\t"     /* jmp_buf->S1 */
+                   "st.d $s2,   $a0, 0x20\n\t"     /* jmp_buf->S2 */
+                   "st.d $s3,   $a0, 0x28\n\t"     /* jmp_buf->S3 */
+                   "st.d $s4,   $a0, 0x30\n\t"     /* jmp_buf->S4 */
+                   "st.d $s5,   $a0, 0x38\n\t"     /* jmp_buf->S5 */
