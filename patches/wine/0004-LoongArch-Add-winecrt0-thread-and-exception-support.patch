+{
+    DWORD mov_a2_ra;     /* move $a2, $ra */
+    DWORD bl_next;       /* bl .+4 (ra = address of next insn) */
+    DWORD addi_t0_ra;    /* addi.d $t0, $ra, 20 */
+    DWORD ld_a0_t0;      /* ld.d $a0, $t0, 0 */
+    DWORD ld_a1_t0;      /* ld.d $a1, $t0, 8 */
+    DWORD ld_t0_t0;      /* ld.d $t0, $t0, 16 */
+    DWORD jirl_zero_t0;  /* jirl $zero, $t0, 0 */
+    const char *dll;
+    const char *name;
+    const void *entry;
+};
 #else
 struct stub
 {
@@ -484,6 +500,17 @@ static ULONG_PTR allocate_stub( const char *dll, const char *name )
     stub->dll       = dll;
     stub->name      = name;
     stub->entry     = stub_entry_point;
+#elif defined(__loongarch__)
+    stub->mov_a2_ra  = 0x00150026; /* move $a2, $ra */
+    stub->bl_next    = 0x54000400; /* bl .+4 */
+    stub->addi_t0_ra = 0x02c0502c; /* addi.d $t0, $ra, 20 */
+    stub->ld_a0_t0   = 0x28c00184; /* ld.d $a0, $t0, 0 */
+    stub->ld_a1_t0   = 0x28c02185; /* ld.d $a1, $t0, 8 */
+    stub->ld_t0_t0   = 0x28c0418c; /* ld.d $t0, $t0, 16 */
+    stub->jirl_zero_t0 = 0x4c000180; /* jirl $zero, $t0, 0 */
+    stub->dll        = dll;
+    stub->name       = name;
+    stub->entry      = stub_entry_point;
 #else
     stub->movq_rdi[0]     = 0x48;  /* movq $dll,%rcx */
     stub->movq_rdi[1]     = 0xb9;
